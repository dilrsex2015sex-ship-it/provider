{
  "name": "provider",
  "version": "0.1.0",
  "private": false,
  "description": "Provider package — API/SDK",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prepare": "husky install",
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --max-warnings=0",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=20.19.1"
  },
  "files": ["dist"],
  "dependencies": {
    "@types/node": "^22.10.5"
  },
  "devDependencies": {
    "typescript": "^5.1.6",
    "ts-node-dev": "^2.0.0",
    "vitest": "^1.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "husky": "^8.0.0"
  }
}
